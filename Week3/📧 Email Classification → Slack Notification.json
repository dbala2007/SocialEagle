      "parameters": {
        "jsCode": "const aiText = $input.item.json.message?.content || $input.item.json.choices?.[0]?.message?.content || '';\n\nlet parsed;\ntry {\n  const clean = aiText.replace(/```json|```/g, '').trim();\n  parsed = JSON.parse(clean);\n} catch (e) {\n  parsed = { category: 'General', priority: 'Low', summary: 'Could not parse AI response' };\n}\n\nconst prev = $('\\ud83d\\udce8 Gmail Trigger').item.json;\n\nconst emojiMap = {\n  'Support': '\\ud83d\\udd27',\n  'Sales': '\\ud83d\\udcb0',\n  'Spam': '\\ud83d\\uddd1\\ufe0f',\n  'General': '\\ud83d\\udccc'\n};\n\nconst priorityEmoji = {\n  'High': '\\ud83d\\udd34',\n  'Medium': '\\ud83d\\udfe1',\n  'Low': '\\ud83d\\udfe2'\n};\n\nreturn [{\n  json: {\n    category: parsed.category || 'General',\n    priority: parsed.priority || 'Low',\n    summary: parsed.summary || 'No summary',\n    categoryEmoji: emojiMap[parsed.category] || '\\ud83d\\udccc',\n    priorityEmoji: priorityEmoji[parsed.priority] || '\\ud83d\\udfe2',\n    from: prev.from || 'Unknown',\n    subject: prev.subject || '(No Subject)',\n    date: prev.date || new Date().toISOString()\n  }\n}];"
      },
