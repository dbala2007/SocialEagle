      "parameters": {
        "jsCode": "const aiResponse = $input.item.json.message?.content || $input.item.json.choices?.[0]?.message?.content || '{}';\n\nlet parsed;\ntry {\n  const cleaned = aiResponse.replace(/```json|```/g, '').trim();\n  parsed = JSON.parse(cleaned);\n} catch (e) {\n  parsed = { category: 'General', confidence: 'Low', reason: 'Could not parse AI response' };\n}\n\nconst validCategories = ['Support', 'Sales', 'Spam', 'General'];\nif (!validCategories.includes(parsed.category)) {\n  parsed.category = 'General';\n}\n\nreturn [{\n  json: {\n    category: parsed.category,\n    confidence: parsed.confidence || 'Medium',\n    reason: parsed.reason || 'Classification complete',\n    sender: $('📋 Extract Email Fields').item.json.sender,\n    subject: $('📋 Extract Email Fields').item.json.subject,\n    body: $('📋 Extract Email Fields').item.json.body,\n    classified_at: new Date().toISOString()\n  }\n}];"
      },
